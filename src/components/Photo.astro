---
// A photo from public/images/, cropped to a fixed shape.
//
// Usage: <Photo file="home-turtle.jpg" label="Turtle AUV in the water" />
// Renders nothing if the file doesn't exist, so a missing photo never leaves a gap.
import { imageExists, imageUrl } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  file: string;        // filename inside public/images/
  label: string;       // what the photo shows (used as alt text)
  ratio?: string;      // width / height, e.g. '4 / 3' or '16 / 9'
}

const { file, label, ratio = '4 / 3' } = Astro.props;
---

{imageExists(file) && (
  <div class="photo" style={`aspect-ratio: ${ratio};`}>
    <img src={imageUrl(file)} alt={label} loading="lazy" decoding="async" />
  </div>
)}

<style>
  .photo {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
</style>
