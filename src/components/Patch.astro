---
// Inset photos that sit across the edge between two sections (Colossal's small photos laid over
// the edge of a big one). Each edge on the site uses a different shape, so they don't repeat:
//   frame    one photo with a thin offset frame and a dot on its corner
//   lens     a round photo with a ring and crosshair ticks
//   contact  a film strip of three square frames, numbered
//   strip    a tall narrow photo at the side of the page, with a sideways label
//   pano     a wide panoramic strip with corner brackets
//   stack    two photos overlapping at an angle, with a small square marker
//
// Two ways to place it:
//   - first inside whatever comes below the edge: it pulls itself up over the edge and pushes
//     that section's content down below it;
//   - with `straddle`, between two sections: it takes no space and simply overlaps both.
// Like Colossal, never on the edge right under a page header or the Home video.
//
// Photos live in public/images/patches/. People, lab and machine photos stay natural; only
// nature photos get false colour (see the photo rule in the README).
import { imageUrl } from '../lib/images';
import { keepDots } from '../lib/text';

type Variant = 'frame' | 'lens' | 'contact' | 'strip' | 'pano' | 'stack';

interface Props {
  variant?: Variant;
  image?: string;       // one photo (frame, lens, strip, pano)
  images?: string[];    // several photos: contact (three), stack (front, back)
  caption?: string;     // short label in [ brackets ]
  captions?: string[];  // contact: one short label per frame
  side?: 'left' | 'center' | 'right';
  pull?: string;        // extra distance to pull up, e.g. the padding at the top of the section it sits in
  overlap?: string;     // how far it crosses into the section above
  straddle?: boolean;   // overlap both sections without taking any space
}

const { variant = 'frame', image, caption, captions = [], side = 'left', pull = '0px', overlap, straddle = false } = Astro.props;
const images = Astro.props.images ?? (image ? [image] : []);
const defaultOverlap: Record<Variant, string> = {
  frame: 'clamp(2.5rem, 0.5rem + 6vw, 8.5rem)',
  lens: 'clamp(3rem, 1rem + 5vw, 8rem)',
  contact: 'clamp(2rem, 1rem + 3vw, 4.5rem)',
  strip: 'clamp(3rem, 1rem + 6vw, 8.5rem)',
  pano: 'clamp(2rem, 1rem + 2.5vw, 4.5rem)',
  stack: 'clamp(2rem, 0.5rem + 3vw, 4.5rem)',
};
const src = (file: string) => imageUrl(`patches/${file}`);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  class:list={['container', 'patch-row', `patch-row--${side}`, `patch-row--${variant}`, { 'patch-row--straddle': straddle }]}
  style={`--pull: ${pull}; --overlap: ${overlap ?? defaultOverlap[variant]};`}
  aria-hidden="true"
>
  {variant === 'frame' && (
    <figure class="patch patch--frame" data-drift="40">
      <span class="frame-line"></span>
      <img src={src(images[0])} alt="" width="1200" height="800" loading="lazy" decoding="async" />
      {caption && <figcaption class="label patch-caption">[ {keepDots(caption)} ]</figcaption>}
    </figure>
  )}

  {variant === 'lens' && (
    <figure class="patch patch--lens" data-drift="50">
      <span class="lens-photo">
        <span class="lens-ring"></span>
        <img src={src(images[0])} alt="" width="900" height="900" loading="lazy" decoding="async" />
      </span>
      {caption && <figcaption class="label patch-caption">[ {keepDots(caption)} ]</figcaption>}
    </figure>
  )}

  {variant === 'contact' && (
    <figure class="patch patch--contact" data-drift="40">
      <ol class="contact-frames">
        {images.map((file, i) => (
          <li>
            <span class="label contact-num">{pad(i + 1)}</span>
            <img src={src(file)} alt="" width="600" height="600" loading="lazy" decoding="async" />
            {captions[i] && <span class="label contact-cap">{captions[i]}</span>}
          </li>
        ))}
      </ol>
    </figure>
  )}

  {variant === 'strip' && (
    <figure class="patch patch--strip" data-drift="70">
      <img src={src(images[0])} alt="" width="600" height="1400" loading="lazy" decoding="async" />
      {caption && <figcaption class="label strip-label">[ {caption} ]</figcaption>}
    </figure>
  )}

  {variant === 'pano' && (
    <figure class="patch patch--pano" data-drift="30">
      <span class="pano-corners"></span>
      <img src={src(images[0])} alt="" width="1800" height="500" loading="lazy" decoding="async" />
      {caption && <figcaption class="label patch-caption">[ {keepDots(caption)} ]</figcaption>}
    </figure>
  )}

  {variant === 'stack' && (
    <figure class="patch patch--stack" data-drift="40">
      {images[1] && <img class="stack-back" src={src(images[1])} alt="" width="900" height="600" loading="lazy" decoding="async" />}
      <img class="stack-front" src={src(images[0])} alt="" width="1200" height="800" loading="lazy" decoding="async" />
      <span class="stack-mark"></span>
      {caption && <figcaption class="label patch-caption">[ {keepDots(caption)} ]</figcaption>}
    </figure>
  )}
</div>

<style>
  /* ---------- Placement ---------- */

  .patch-row {
    position: relative;
    z-index: 2; /* above the sections it crosses */
    display: flex;
    justify-content: flex-start;
    margin-top: calc(-1 * (var(--pull) + var(--overlap)));
    margin-bottom: var(--space-lg);
    pointer-events: none;
  }

  .patch-row--center {
    justify-content: center;
  }

  .patch-row--right {
    justify-content: flex-end;
  }

  /* Straddle: a zero-height row on the edge; the photo hangs over both sections */
  .patch-row--straddle {
    height: 0;
    margin-block: 0; /* only top and bottom: the sides stay auto so the row stays centred */
    align-items: flex-start;
  }

  .patch-row--straddle .patch {
    flex: none;
    margin-top: calc(-1 * var(--overlap));
  }

  .patch {
    position: relative;
    margin: 0;
  }

  .patch img {
    position: relative;
    width: 100%;
    object-fit: cover;
  }

  /* Captions are small boxed tags with a dark glassy backing, so they read on any photo */
  .patch-caption,
  .strip-label {
    padding: 0.3rem 0.55rem;
    color: var(--color-white);
    background: rgb(6 18 31 / 0.6);
    border: 1px solid rgb(232 241 245 / 0.2);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .patch-caption {
    display: inline-block;
    margin-top: 0.6rem;
    text-wrap: balance; /* if it wraps, both lines get a similar length (no lone "]") */
  }

  .patch-row--right .patch {
    text-align: right;
  }

  /* ---------- frame ---------- */

  .patch--frame {
    width: clamp(15rem, 36%, 32rem);
  }

  .patch--frame img {
    aspect-ratio: 3 / 2;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.25);
  }

  .frame-line {
    position: absolute;
    inset: -0.9rem 0.9rem 0.9rem -0.9rem;
    border: 1px solid var(--color-accent);
  }

  .frame-line::before {
    content: '';
    position: absolute;
    top: -0.4rem;
    left: -0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* ---------- lens: round photo, ring, crosshair ticks ---------- */

  .patch--lens {
    width: clamp(11rem, 22vw, 20rem);
  }

  .lens-photo {
    position: relative;
    display: block;
  }

  .patch--lens img {
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .lens-ring {
    position: absolute;
    inset: -1rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
  }

  /* ticks at 12, 3, 6 and 9 o'clock, poking past the ring */
  .lens-ring::before,
  .lens-ring::after {
    content: '';
    position: absolute;
  }

  .lens-ring::before {
    left: 50%;
    top: -0.8rem;
    bottom: -0.8rem;
    width: 1px;
    background: linear-gradient(var(--color-accent) 0 1.6rem, transparent 1.6rem calc(100% - 1.6rem), var(--color-accent) calc(100% - 1.6rem));
  }

  .lens-ring::after {
    top: 50%;
    left: -0.8rem;
    right: -0.8rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent) 0 1.6rem, transparent 1.6rem calc(100% - 1.6rem), var(--color-accent) calc(100% - 1.6rem));
  }

  /* centred under the lens */
  .patch--lens .patch-caption {
    display: block;
    width: fit-content;
    margin: 1.6rem auto 0;
    text-align: center;
  }

  /* ---------- contact: a dark film strip of three numbered frames ---------- */

  .contact-frames {
    --frame: clamp(6rem, 10vw, 10rem);
    display: grid;
    grid-template-columns: repeat(3, var(--frame));
    gap: 0.5rem;
    margin: 0;
    padding: 1.1rem 0.5rem;
    list-style: none;
    background:
      /* sprocket holes along the top and bottom edges */
      repeating-linear-gradient(90deg, transparent 0 0.45rem, rgb(232 241 245 / 0.55) 0.45rem 0.75rem) top 0.35rem left 0 / 100% 0.3rem no-repeat,
      repeating-linear-gradient(90deg, transparent 0 0.45rem, rgb(232 241 245 / 0.55) 0.45rem 0.75rem) bottom 0.35rem left 0 / 100% 0.3rem no-repeat,
      #050d16;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.3);
  }

  .contact-frames li {
    position: relative;
  }

  .contact-frames img {
    aspect-ratio: 1;
  }

  .contact-num,
  .contact-cap {
    position: absolute;
    z-index: 1;
    left: 0.4rem;
    color: var(--color-white);
    text-shadow: 0 0 0.4rem rgb(0 0 0 / 0.7);
  }

  .contact-num {
    top: 0.35rem;
  }

  .contact-cap {
    bottom: 0.35rem;
  }

  /* ---------- strip: tall narrow photo with a sideways label ---------- */

  .patch--strip {
    width: clamp(7.5rem, 13vw, 12.5rem);
    border-left: 3px solid var(--color-accent);
  }

  /* the strip stays inside the page margin (it used to run off the screen edge, which read as cut off) */
  .patch-row--left .patch--strip {
    border-left: 0;
    border-right: 3px solid var(--color-accent);
  }

  .patch--strip img {
    aspect-ratio: 3 / 7;
  }

  /* the label runs up the side of the strip */
  .strip-label {
    position: absolute;
    top: 0;
    right: calc(100% + 0.6rem);
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .patch-row--left .strip-label {
    right: auto;
    left: calc(100% + 0.6rem);
  }

  /* ---------- pano: wide strip with corner brackets ---------- */

  .patch--pano {
    width: clamp(18rem, 50%, 42rem);
  }

  /* a little taller than a letterbox, so the photo still shows its subject (the tool, not just slush) */
  .patch--pano img {
    aspect-ratio: 12 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* the caption hangs under the photo, outside the corner brackets, so they frame the photo alone */
  .patch--pano .patch-caption {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    margin: 0;
    white-space: nowrap;
  }

  .patch-row--left .patch--pano .patch-caption {
    right: auto;
    left: 0;
  }

  .pano-corners {
    --c: var(--color-accent);
    --L: 1.4rem;
    position: absolute;
    inset: -0.7rem;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--L) 1px,
      linear-gradient(var(--c), var(--c)) top left / 1px var(--L),
      linear-gradient(var(--c), var(--c)) top right / var(--L) 1px,
      linear-gradient(var(--c), var(--c)) top right / 1px var(--L),
      linear-gradient(var(--c), var(--c)) bottom left / var(--L) 1px,
      linear-gradient(var(--c), var(--c)) bottom left / 1px var(--L),
      linear-gradient(var(--c), var(--c)) bottom right / var(--L) 1px,
      linear-gradient(var(--c), var(--c)) bottom right / 1px var(--L);
    background-repeat: no-repeat;
  }

  /* ---------- stack: two photos at an angle ---------- */

  .patch--stack {
    width: clamp(14rem, 30%, 26rem);
  }

  .stack-front {
    aspect-ratio: 3 / 2;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.3);
    outline: 1px solid var(--color-accent); /* a thin cyan hairline a little way out from the photo */
    outline-offset: 5px;
  }

  .patch .stack-back {
    position: absolute;
    top: -16%;
    left: -24%;
    width: 58%;
    aspect-ratio: 3 / 2;
    transform: rotate(-4deg);
    outline: 1px solid var(--color-accent);
    outline-offset: 0.35rem;
  }

  .patch-row--left .patch .stack-back {
    left: auto;
    right: -24%;
    transform: rotate(4deg);
  }

  .stack-mark {
    position: absolute;
    right: -0.45rem;
    bottom: -0.45rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--color-accent);
  }

  /* ---------- Phones: bigger relative to the screen, crossing the edge by about a quarter ---------- */

  @media (max-width: 760px) {
    .patch-row {
      --overlap: 2.5rem !important;
    }

    .patch-row--stack {
      --overlap: 1.25rem !important;
    }

    .patch--frame {
      width: 68%;
    }

    .frame-line {
      inset: -0.6rem 0.6rem 0.6rem -0.6rem;
    }

    .patch--lens {
      width: 46vw;
    }

    .lens-ring {
      inset: -0.6rem;
    }

    .contact-frames {
      --frame: 24vw;
    }

    /* frame labels stay on one line, smaller, so they don't cover the photos */
    .contact-cap {
      font-size: 0.55rem;
      white-space: nowrap;
    }

    .patch--strip {
      width: min(28vw, 9rem);
    }

    .patch--pano {
      width: 86%;
    }

    .pano-corners {
      inset: -0.45rem;
    }

    .patch--stack {
      width: 58%;
    }

    /* frames, corner brackets and corner squares poke out about 0.6rem: keep them inside the
       page margin */
    .patch-row--right .patch:not(.patch--strip) {
      margin-right: 0.6rem;
    }

    .patch-row--left .patch:not(.patch--strip) {
      margin-left: 0.6rem;
    }

    /* a section right under a straddling patch starts its content below the patch */
    :global(.patch-row--straddle + .photo-band .photo-band-inner) {
      padding-top: calc(var(--space-2xl) + 8.5rem);
    }

    :global(.patch-row--straddle + .band) {
      padding-top: 8rem;
    }
  }

  /* Tablets and phones: the photo band after a tall strip starts its headline below the strip,
     and the section after the round lens starts below the lens and its caption */
  @media (max-width: 900px) {
    .patch--strip {
      width: min(28vw, 9rem);
    }

    :global(.patch-row--strip.patch-row--straddle + .photo-band .photo-band-inner) {
      padding-top: calc(min(28vw, 9rem) * 7 / 3 + 1.5rem);
    }
  }

  /* the section after the round lens starts below the lens and its caption: the lens's width,
     less the part that hangs over the band above, plus a little room */
  :global(.patch-row--lens.patch-row--straddle + .band) {
    padding-top: calc(clamp(11rem, 22vw, 20rem) - clamp(3rem, 1rem + 5vw, 8rem) + 1rem);
  }

  @media (max-width: 760px) {
    :global(.patch-row--lens.patch-row--straddle + .band) {
      padding-top: 46vw;
    }
  }
</style>
