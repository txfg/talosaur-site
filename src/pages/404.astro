---
// Shown when a visitor opens an address that doesn't exist. GitHub Pages uses it automatically.
import BaseLayout from '../layouts/BaseLayout.astro';
import { mainNav } from '../data/site';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" noindex>
  <section class="container not-found">
    <p class="label not-found-code">404</p>
    <h1 class="not-found-title">Nothing at this depth.</h1>
    <p class="not-found-text">The page you're looking for doesn't exist or has moved. Try one of these instead.</p>
    <ul class="not-found-links">
      <li><a class="button" href={url('/')}>Home <span aria-hidden="true">→</span></a></li>
      {mainNav.map((item) => (
        <li><a class="button button--outline" href={url(item.href)}>{item.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-2xl);
    min-height: 60vh;
  }

  .not-found-code {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
  }

  .not-found-title {
    max-width: 14ch;
    font-size: var(--text-hero);
  }

  .not-found-text {
    max-width: 38rem;
    margin: var(--space-lg) 0;
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
