---
// Work with us: the contact page. Email and location come from src/data/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PictureCards from '../components/PictureCards.astro';
import StoryBand from '../components/StoryBand.astro';
import { url } from '../lib/url';
import { imageUrl } from '../lib/images';
import { location, contactEmails } from '../data/site';
import { sources } from '../data/problem';

const intro =
  "Do you work with marine life between 50 and 300 meters, in research, conservation, fisheries or offshore energy? We'd love a 20\u2011minute conversation about how you study it today."; // \u2011 is a hyphen that never breaks the line


// Who we work with: the four groups from the intro, each with a photo of what it names, all in
// natural colour so the row reads as one set (public/images/sections/). "needs" says what a missing
// photo should show: until aud-offshore.jpg exists, that card shows a "photo to come" panel.
// Text in [brackets] is a placeholder to fill in later.
const audiences = [
  { image: 'aud-research.jpg', tag: 'Research vehicle · NOAA', title: 'Research', text: 'Footage and eDNA samples from 50–300 m, at a cost that could let a study go back to the same reef again and again.' },
  { image: 'aud-conservation.jpg', tag: 'Reef', title: 'Conservation', text: 'Regular footage of deep reefs in places like Flower Garden Banks, to spot change early and back up decisions about protecting them.' },
  { image: 'aud-fisheries.jpg', tag: 'Fish school', title: 'Fisheries', text: 'Counts and footage of fish on deep reefs and banks, where divers and most surveys never reach.' },
  { image: 'aud-offshore.jpg', needs: 'an offshore platform in the Gulf', title: 'Offshore energy', text: 'A low-cost look at the seafloor and the life around platforms, pipelines and cables in the Gulf.' },
];

// "What we bring back" and "How a project works": new copy (not from the Content doc), edit freely.
// Turtle is still being built, so both are written as plans.
// (\u00a0 is a space that never breaks the line, so "300 m" stays together)
const deliverIntro = 'For every project, this is what we plan to hand over.';
const deliverables = [
  { title: 'Footage', text: 'Video of the life between 50 and 300\u00a0m, at the site and depth you choose, filmed often enough to compare one visit with the next.' },
  { title: 'Dive records', text: 'Where and when each dive happened and how deep it went, so every clip can be matched with your own data.' },
  { title: 'Water samples', text: 'Water from the same depths for eDNA testing, which can show what lives there even when it stays off camera.' },
  { title: 'A short report', text: 'What we saw, in plain language, with the best clips picked out and ready to share.' },
];
const steps = [
  { title: 'Talk', text: 'A first call about your work, the places you study and what you need to see there.' },
  { title: 'Plan', text: 'Together we will pick the site, the depth and the dates, and what each dive needs to bring back.' },
  { title: 'Dive', text: 'We will take Turtle out by boat to film and sample, and keep you posted from the water.' },
  { title: 'Deliver', text: 'We will hand everything over, then talk about what to look at next time.' },
];

// "Built around your questions": the kind of question each group from "Who we work with" brings, set
// big, and what partners who talk to us early get. New copy (not from the Content doc), edit freely.
const questions = [
  { text: 'How is the deep reef changing?', who: 'Research · Conservation', style: 'solid' },
  { text: 'Where do the grouper gather?', who: 'Fisheries', style: 'mono' },
  { text: 'What lives around the platform?', who: 'Offshore energy', style: 'outline' },
];
const earlyPerks = [
  { title: 'A say in the design', text: 'Which depths, which animals and which samples matter for your work.' },
  { title: 'Early dives', text: 'We plan to dive first with the partners who helped shape Turtle.' },
  { title: 'News from the build', text: 'Test results as they happen, on our News page and live stream.' },
];

// "Ways to work together": the first is the projects above; the other three come from the Content doc's
// Donate page ("Give in kind", "Sponsor a project") plus advisors. "href" is where the link goes.
const generalEmail = contactEmails[0].email;
const ways = [
  { title: 'Survey partner', text: 'Bring us a site and a question. We plan the dives with you and hand over the footage, samples and report.', link: 'Email us', href: `mailto:${generalEmail}` },
  { title: 'Field partner', text: 'Parts, equipment, pool time or boat days: every test gets Turtle closer to the Gulf.', link: 'Email us', href: `mailto:${generalEmail}` },
  { title: 'Advisor', text: 'Scientists, engineers and boat crews who can spare an hour to tell a student team what it is missing.', link: 'Email us', href: `mailto:${generalEmail}` },
  { title: 'Sponsor', text: 'Back a build like Turtle or our eDNA sampler, or fund a field test.', link: 'Ways to give', href: url('/donate') },
];

// "Good to know": short answers to what partners ask first. Kept to what the team can say today:
// nothing about how Turtle works inside, no prices, no dates.
const faqs = [
  { q: 'Is Turtle ready?', a: 'Not yet. Turtle is being built and tested now: first in the pool, then in Texas lakes, then in the Gulf. We plan to start partner projects once it has proven itself there, and we will keep you posted until then.' },
  { q: 'How deep will it go?', a: 'Turtle is being built for the twilight zone, between 50 and 300\u00a0m: below where divers can safely work, and above where most deep-sea vehicles are sent.' },
  { q: 'Where can you work?', a: 'We are starting in the Gulf of Mexico, close to home, with Flower Garden Banks as our first goal. Places further away come later: tell us where you work and we will tell you when it might be possible.' },
  { q: 'What will a project cost?', a: 'It depends on the site, the depth and how many dives you need, so we work it out with you. Keeping the cost low is the reason Turtle exists: commercial underwater robots cost $50,000 to over $1 million, and running a research ship tens of thousands of dollars a day.', sources: [sources.robots, sources.ship] },
  { q: 'Who owns the footage and data?', a: 'We agree that with each partner before the first dive.' },
  { q: 'Can we come along on a dive?', a: 'We would like that. It depends on the boat and the site, so we plan it together.' },
];
---

<BaseLayout title="Work with us" description={intro} headerOverlay>
  <PageHeader title="Work with us" heading="Get in touch" href="/work-with-us" intro={intro} caption="Research · Conservation · Fisheries · Offshore" image="work-with-us.jpg" imagePosition="80% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container contact-layout" id="contact">
      <dl class="contact-list" data-reveal-group>
        <!-- One row per address (src/data/site.ts, contactEmails): what it's for, then the address -->
        {contactEmails.map((contact) => (
          <div class="contact-row">
            <dt class="label">{contact.label}</dt>
            <dd>
              <a class="contact-value contact-email" href={`mailto:${contact.email}`}>{contact.email} <span aria-hidden="true">→</span></a>
            </dd>
          </div>
        ))}
        <div class="contact-row">
          <dt class="label">Location</dt>
          <dd><span class="contact-value">{location}</span></dd>
        </div>
      </dl>

      <!-- Picture beside the contact details, in the style of Colossal's species pages: a big edited
           photo (jellyfish in a magenta and orange map), a lime colour block behind it with a notch
           cut out, and an orange dot on one corner. (No small inset photo here: insets never sit
           right under a page header.) Picture: public/images/accents/jelly.jpg. -->
      <figure class="collage" aria-hidden="true" data-drift="50">
        <span class="collage-block"></span>
        <img class="collage-main" src={imageUrl('accents/jelly.jpg')} alt="" width="1280" height="960" loading="lazy" decoding="async" />
        <span class="collage-dot"></span>
        <span class="label collage-tag">[ Jellyfish ]</span>
      </figure>
    </section>
  </div>

  <!-- Story band: the 20-minute conversation, over the feather star on the canyon wall (NOAA) in
       teal and pink, like the "Allied with others" band on Colossal's company page.
       Copy: the big line is from the Content doc intro ("a 20-minute conversation"); the two columns are placeholders. -->
  <StoryBand
    variant="statement"
    image="story-talk.jpg"
    position="60% 50%"
    tag="A conversation about your work"
    title="20 minutes"
    items={[
      { title: "What we'll ask", text: 'How you study marine life at 50–300 m today, what it costs you, and what you wish you could see more often.' },
      { title: "What you'll get", text: 'A first look at what we are building, and a say in what it should do for work like yours.' },
    ]}
  />

  <!-- Light band: who we work with -->
  <div class="band band--top theme-light">
    <!-- Section 01: who we work with, four photo cards -->
    <section class="container audiences">
      <SectionHeader number={1} title="Who we work with" />
      <PictureCards items={audiences} columns={4} />
    </section>
  </div>

  <!-- Built around your questions: deep navy, with the questions partners bring set big in three
       different type treatments (solid wide capitals, thin mono in lime, outlined capitals), each tagged
       with who asks it. Under them, a diver surveying a reef at Flower Garden Banks (NOAA, natural
       colour: public/images/sections/partners-diver.jpg) beside what early partners get. -->
  <section class="band partners">
    <div class="container">
      <p class="label partners-tag">[ Built around your questions ]</p>
      <ul class="questions" role="list">
        {questions.map((item) => (
          <li class={`question question--${item.style}`}>
            <span class="question-text">{item.text}</span>
            <span class="label question-who">[ {item.who} ]</span>
          </li>
        ))}
      </ul>

      <div class="partners-grid">
        <figure class="partners-photo" data-drift="60">
          <img src={imageUrl('sections/partners-diver.jpg')} alt="A diver with a clipboard surveying a reef along a measuring line" width="1400" height="905" loading="lazy" decoding="async" />
          <figcaption class="label">[ Reef survey · Flower Garden Banks ]</figcaption>
        </figure>

        <div class="partners-body">
          <h2 class="wide-head">Your question shapes Turtle</h2>
          <p>Reef surveys like this one are done by divers, who can't safely go much below 40&nbsp;m. Deeper down, the reefs at Flower Garden Banks are surveyed about once a year, by remotely operated vehicle. Turtle is still being built, so the partners we talk to now help decide what it films, what it samples and where it goes first.</p>
          <dl class="perks">
            {earlyPerks.map((perk) => (
              <div>
                <dt>{perk.title}</dt>
                <dd>{perk.text}</dd>
              </div>
            ))}
          </dl>
          <p class="label partners-sources">
            Sources: <a href={sources.diving.href}>{sources.diving.label}</a> · <a href={sources.fgbDeep.href}>{sources.fgbDeep.label}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What we bring back: a bright orange band (not every stretch has to be navy) with a wide technical
       title (Martian Mono) and the coral wall in natural colour, its corner notched like the colour
       blocks on Colossal's pages. Photo: public/images/sections/work-coral.jpg. -->
  <section class="band theme-sun deliver">
    <div class="container deliver-grid">
      <figure class="deliver-photo" data-drift="70">
        <img src={imageUrl('sections/work-coral.jpg')} alt="A reef wall covered in coral, with a school of small red fish in deep blue water" width="1100" height="1650" loading="lazy" decoding="async" />
        <figcaption class="label">[ Reef wall · School of fish ]</figcaption>
      </figure>

      <div class="deliver-body">
        <p class="label">[ Once Turtle is in the water ]</p>
        <h2 class="tech-title deliver-title">What we bring back</h2>
        <p class="deliver-intro">{deliverIntro}</p>
        <ul class="deliver-list">
          {deliverables.map((item) => (
            <li>
              <h3 class="wide-head">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How a project works: four steps on a violet to deep blue gradient. On laptops each step sits a
       little lower than the one before, like a dive going down, joined by a stepped line from ring to
       ring; on tablets and phones they become a timeline down the left. No pictures: the type carries it. -->
  <section class="band theme-violet steps">
    <div class="container">
      <p class="label steps-tag">[ From first call to footage ]</p>
      <h2 class="tech-title steps-title">How a project works</h2>
      <ol class="steps-list">
        {steps.map((step, i) => (
          <li style={`--i: ${i}`}>
            <span class="step-marker" aria-hidden="true"></span>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="wide-head">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <a class="button steps-button" href="#contact">Start with a call <span aria-hidden="true">↑</span></a>
    </div>
  </section>

  <!-- Ways to work together: a lime band with one big row per way in, like an index. A row turns
       dark when you point at it. No pictures: the big condensed type carries it. -->
  <section class="band theme-lime ways">
    <div class="container">
      <div class="ways-head">
        <p class="label">[ Four ways in ]</p>
        <h2 class="ways-title">Ways to work together</h2>
      </div>
      <ul class="ways-list" role="list">
        {ways.map((way) => (
          <li>
            <a class="way" href={way.href}>
              <span class="way-title">{way.title}</span>
              <span class="way-text">{way.text}</span>
              <span class="way-link label">{way.link} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Good to know: short answers, opened one at a time, beside the black coral from Flower Garden
       Banks as violet halftone dots (an edit of NOAA's photo: public/images/sections/partners-coral-dots.webp,
       made by stills_site/make_new_sections.py). -->
  <section class="band theme-light faq">
    <div class="container faq-grid">
      <div class="faq-side">
        <p class="label">[ Before you write ]</p>
        <h2 class="tech-title faq-title">Good to know</h2>
        <figure class="faq-coral" aria-hidden="true">
          <img src={imageUrl('sections/partners-coral-dots.webp')} alt="" width="1200" height="1013" loading="lazy" decoding="async" />
          <figcaption class="label">[ Black coral · Flower Garden Banks ]</figcaption>
        </figure>
      </div>

      <div class="faq-list">
        {faqs.map((item, i) => (
          <details open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p>
              {item.a}
              {item.sources && (
                <span class="faq-sources label">
                  {' '}Sources: {item.sources.map((source, j) => (
                    <>{j > 0 && ' · '}<a href={source.href}>{source.label}</a></>
                  ))}
                </span>
              )}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- One big photo (anemone, false colour) leading on to Donate. Copy: the Donate page heading. -->
  <PhotoBand image="work-with-us.jpg" position="50% 50%" heading="Support our research" tag="Parts · Testing · Field trips">
    <a class="button" href={url('/donate')}>Donate <span aria-hidden="true">→</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  /* Contact details on the left, the collage on the right */
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .audiences {
    padding-top: var(--space-lg);
  }

  /* ---------- Collage ---------- */

  /* it sits level with the lower contact rows, so it isn't right under the photo header */
  .collage {
    position: relative;
    align-self: end;
    margin: var(--space-2xl) 0 var(--space-xl) var(--space-lg);
  }

  /* Lime block behind the photo, poking out at the top left, with a notch cut from its bottom right */
  .collage-block {
    position: absolute;
    top: calc(-1 * var(--space-md));
    left: calc(-1 * var(--space-lg));
    width: 72%;
    height: calc(100% + var(--space-lg));
    background: var(--color-lime);
    clip-path: polygon(0 0, 100% 0, 100% 62%, 58% 62%, 58% 100%, 0 100%);
  }

  .collage-main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .collage-dot {
    position: absolute;
    top: -0.55rem;
    right: -0.55rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .collage-tag {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0.3rem 0.55rem;
    color: var(--color-white);
    background: rgb(6 18 31 / 0.6);
  }

  .contact-list {
    margin: 0;
    border-bottom: 1px solid var(--color-line);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: baseline;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  .contact-row dd {
    margin: 0;
    min-width: 0;
  }

  /* Big, Colossal-style contact details (three addresses, so a little smaller than one would be) */
  .contact-value {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    word-spacing: 0.1em; /* the condensed face squeezes the spaces too */
    font-weight: 800;
    font-size: clamp(1.5rem, 0.9rem + 2vw, 2.8rem); /* sized so the longest address and its arrow fit on one line */
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere; /* long email addresses wrap instead of overflowing */
  }

  .contact-email {
    color: var(--color-accent);
    text-decoration: none;
    text-transform: none;
  }

  .contact-email span {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }

  .contact-email:hover span {
    transform: translateX(6px);
  }

  /* Tablet and phone: the collage goes under the contact details */
  @media (max-width: 1199px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    /* the right margin keeps the orange dot on the corner inside the page margin */
    .collage {
      width: min(34rem, 88%);
      margin: var(--space-md) 0.6rem calc(var(--space-xl) + var(--space-md)) auto;
    }
  }

  /* ---------- Built around your questions (navy) ---------- */

  .partners {
    padding-top: var(--space-2xl);
  }

  .partners-tag {
    margin: 0;
  }

  /* the questions, big, each in its own type treatment, stepping right as they go down */
  .questions {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .question {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem var(--space-md);
    padding-block: clamp(0.6rem, 1.2vw, 1.1rem);
    border-bottom: 1px solid var(--color-line);
  }

  .question:nth-child(2) {
    padding-left: clamp(0rem, 8vw, 9rem);
  }

  .question:nth-child(3) {
    padding-left: clamp(0rem, 16vw, 18rem);
  }

  .question-text {
    font-size: clamp(1.9rem, 0.6rem + 4.6vw, 5.4rem);
    line-height: 0.98;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .question--solid .question-text,
  .question--outline .question-text {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 900;
    letter-spacing: -0.01em;
    word-spacing: 0.12em; /* the condensed face squeezes the spaces too */
  }

  .question--mono .question-text {
    font-family: var(--font-tech);
    font-stretch: 112.5%;
    font-weight: 300;
    font-size: clamp(1.5rem, 0.5rem + 3.6vw, 4.2rem);
    color: var(--color-lime);
  }

  /* outlined capitals: just the edge of each letter */
  .question--outline .question-text {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-text);
  }

  .question-who {
    color: var(--color-muted);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
    margin-top: var(--space-2xl);
  }

  .partners-photo {
    margin: 0;
  }

  .partners-photo img {
    width: 100%;
  }

  .partners-photo figcaption {
    margin-top: 0.6rem;
    color: var(--color-muted);
  }

  .partners-body p {
    margin: var(--space-md) 0 0;
    color: var(--color-muted);
  }

  .perks {
    margin: var(--space-lg) 0 0;
    border-top: 1px solid var(--color-line);
  }

  .perks div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
  }

  .perks dt {
    font-weight: 600;
    color: var(--color-lime);
  }

  .perks dd {
    margin: 0;
    color: var(--color-muted);
  }

  .partners-body .partners-sources {
    margin-top: var(--space-sm);
  }

  .partners-sources a {
    color: var(--color-muted);
  }

  /* ---------- Ways to work together (lime) ---------- */

  .theme-lime {
    --color-bg: var(--color-lime);
    --color-text: #0b1620;
    --color-muted: rgb(11 22 32 / 0.78);
    --color-line: rgb(11 22 32 / 0.3);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .ways {
    padding-top: var(--space-2xl);
  }

  .ways-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-sm);
  }

  .ways-head .label {
    order: 2;
    margin: 0;
  }

  /* the site's own condensed headline type, very big, for contrast with the mono titles around it */
  .ways-title {
    font-size: clamp(2.6rem, 1rem + 6.4vw, 7.5rem);
    line-height: 0.9;
  }

  .ways-list {
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-text);
  }

  .way {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) 8.5rem;
    align-items: baseline;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition:
      background var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .way:hover,
  .way:focus-visible {
    background: var(--color-text);
    color: var(--color-lime);
  }

  .way-title {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 900;
    font-size: clamp(1.8rem, 1rem + 2.6vw, 3.4rem);
    line-height: 0.95;
    word-spacing: 0.12em;
    text-transform: uppercase;
  }

  .way-text {
    color: inherit;
    opacity: 0.85;
  }

  .way-link {
    color: inherit;
    white-space: nowrap;
    text-align: right;
  }

  .way-link span {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }

  .way:hover .way-link span {
    transform: translateX(4px);
  }

  /* ---------- Good to know (light) ---------- */

  .faq {
    padding-top: var(--space-2xl);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
