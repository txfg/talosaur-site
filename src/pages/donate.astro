---
// Donate: ways to help plus a contact button. No online payments.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PictureCards from '../components/PictureCards.astro';
import StoryBand from '../components/StoryBand.astro';
import { financeContact, contactHref } from '../data/site';

const intro =
  'Talosaur is student-built and runs on a tight budget. Your support funds parts, testing and field trips, and helps us bring affordable ocean exploration to more people.';

// Each way to help has a colour block on top with its number in big thin type (Colossal's colour
// tiles). No photo: a picture of something else would suggest the wrong thing.
const waysToHelp = [
  { title: 'Fund research', text: 'Support a specific study or field test' },
  { title: 'Sponsor a project', text: 'Back a build like Turtle or our eDNA sampler' },
  { title: 'Give in kind', text: 'Parts, equipment, pool or boat time' },
];

// Where it goes: parts, testing and field trips (the header's caption), each with a photo that goes
// with it (public/images/sections/, natural colour). Text in [brackets] is a placeholder to fill in later.
// "needs" says what a missing photo should show: until support-testing.jpg exists, that card shows a
// "photo to come" panel.
const support = [
  { image: 'support-parts.jpg', tag: 'Machining', title: 'Parts', text: 'Materials and parts for the next build, from the hull to the mounts and fittings.' },
  { image: 'support-testing.jpg', needs: 'Turtle in the pool', title: 'Testing', text: 'Pool time and days on the lake, where every new version is tried before it goes near the sea.' },
  { image: 'support-field-trips.jpg', tag: 'Under way', title: 'Field trips', text: 'Boat time and travel to the coast, for tests off Galveston and, later, the deep reefs offshore.' },
];

const financeHref = contactHref(financeContact);
---

<BaseLayout title="Donate" description={intro} headerOverlay>
  <PageHeader title="Donate" heading="Support our research" href="/donate" intro={intro} caption="Parts · Testing · Field trips" image="donate.jpg" imagePosition="40% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container">
      <SectionHeader number={1} title="Ways to help" />
      <ol class="ways" data-reveal-group>
        {waysToHelp.map((way, i) => (
          <li class="way">
            <div class="way-tile" aria-hidden="true">
              <span class="way-big">{String(i + 1).padStart(2, '0')}</span>
              <span class="way-plus">+</span>
            </div>
            <h3 class="way-title">{way.title}</h3>
            <p class="way-text">{way.text}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <!-- Story band: the ray (NOAA) from orange at the top to violet at the bottom, like the
       "Modern biology built upon the past" band on Colossal's company page. Copy: the big line and
       the two column titles are from the Content doc intro; the column text is a placeholder. -->
  <StoryBand
    variant="statement"
    image="story-donate.jpg"
    position="55% 50%"
    tag="Why it matters"
    title="Affordable ocean exploration"
    items={[
      { title: 'Student-built', text: 'Talosaur is designed, built and tested by students from Texas A&M and UT Austin, mostly in College Station.' },
      { title: 'On a tight budget', text: 'Commercial underwater robots cost $50,000 to over $1 million, and a research ship tens of thousands of dollars a day. We are building one for a fraction of that.' },
    ]}
  />

  <!-- Light band: where it goes -->
  <div class="band band--top theme-light">
    <!-- Section 02: where it goes, three photo cards -->
    <section class="container where">
      <SectionHeader number={2} title="Where it goes" />
      <PictureCards items={support} columns={3} />
    </section>
  </div>


  <!-- One big photo (zoanthids and a sea slug, false colour) carrying the contact button and note -->
  <PhotoBand image="donate.jpg" position="55% 50%" heading="Your support funds parts, testing and field trips." size="md">
    <div class="contact-box">
      {financeHref ? (
        <a class="button" href={financeHref}>Contact our finance team <span aria-hidden="true">→</span></a>
      ) : (
        <span class="button button--disabled" aria-disabled="true">Contact our finance team</span>
      )}
      {financeHref ? <p class="label donate-email">{financeContact}</p> : <p class="label">Link: {financeContact}</p>}
      <p class="contact-note">No online payments on the site for now; every donation starts with a conversation.</p>
    </div>
  </PhotoBand>
</BaseLayout>

<style>
  .where {
    padding-top: var(--space-lg);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each way to help is a column: a colour tile, then a thin line, the number and the text */
  .way {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* A colour block with the number in the story bands' thin capitals: orange, lime, violet */
  .way-tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    aspect-ratio: 4 / 3;
    margin: 0 0 var(--space-xs);
    padding: var(--space-md);
    color: var(--light-text);
    background: var(--color-orange);
  }

  .way:nth-child(2) .way-tile {
    background: var(--color-lime);
  }

  .way:nth-child(3) .way-tile {
    color: var(--color-white);
    background: var(--color-violet);
  }

  .way-big {
    font-family: var(--font-display);
    font-weight: 200;
    font-stretch: 125%;
    font-size: clamp(4rem, 2rem + 6vw, 8rem);
    line-height: 0.8;
  }

  .way-plus {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 1.25rem;
  }

  /* the small square on the block's corner, a different colour per block */
  .way-tile::after {
    content: '';
    position: absolute;
    right: -0.45rem;
    bottom: -0.45rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--color-violet);
  }

  .way:nth-child(2) .way-tile::after {
    background: var(--color-orange);
  }

  .way:nth-child(3) .way-tile::after {
    background: var(--color-lime);
  }

  .way-title {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-accent);
    font-size: var(--text-xl);
  }

  .way-text {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .button--disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .donate-email {
    margin: 0;
    color: var(--color-white);
    text-transform: none; /* addresses stay lowercase everywhere */
  }

  .contact-note {
    max-width: 38rem;
    margin: var(--space-sm) 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .ways {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    /* phones: each block shrinks to a small square beside its title and text */
    .way {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 0.4rem var(--space-md);
    }

    .way-tile {
      grid-row: 1 / 3;
      align-self: start;
      aspect-ratio: 1;
      margin: 0;
      padding: 0.5rem;
    }

    .way-big {
      font-size: 2.6rem;
    }

    .way-plus {
      font-size: 0.85rem;
    }

    /* the corner square stays inside the block, so nothing pokes into the text */
    .way-tile::after {
      right: -0.3rem;
      bottom: -0.3rem;
      width: 0.6rem;
      height: 0.6rem;
    }

    .way-title {
      padding-top: 0;
      border-top: 0;
    }

    .way-text {
      font-size: var(--text-base);
    }
  }
</style>
