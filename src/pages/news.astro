---
// News page: every entry in src/content/news/, newest first.
// To add an update, add a Markdown file to that folder (see README).
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import PhotoBand from '../components/PhotoBand.astro';
import TestRoute from '../components/TestRoute.astro';
import { twitchUrl } from '../data/site';
import { getSortedNews, formatNewsDate } from '../lib/news';
import { imageExists } from '../lib/images';

const entries = await getSortedNews();

// Where we test: the stops on the test ladder from the Turtle drawing (Home page), from the pool in
// College Station out to Flower Garden Banks. x and y place each stop on the map (left %, top %,
// printed by stills_site/make_sections.py route_map). Each stop has a small photo: until its file
// is in public/images/sections/, a "photo to come" panel shows what it should be.
// Text in [brackets] is a placeholder to fill in later.
const stops = [
  { name: 'Pool', place: 'College Station', x: 45.4, y: 27.4, lead: [2.4, 0.6], image: 'test-pool.jpg', needs: 'A pool test', text: 'First up. Calm, clear water to check that Turtle stays watertight and handles the way it should.' },
  { name: 'Lake Bryan', place: 'Bryan', x: 43.6, y: 25.8, image: 'test-lake-bryan.jpg', needs: 'Lake Bryan', text: 'Open water close to home: longer runs in murky water, more like a real survey.', lead: [-2.2, -2.8] },
  { name: 'Lake Travis', place: 'Austin', x: 23.6, y: 31.5, image: 'test-lake-travis.jpg', needs: 'Lake Travis', text: 'A deeper lake near Austin, to take Turtle further down.' },
  { name: 'Galveston', place: 'Gulf coast', x: 66.7, y: 53.6, image: 'test-galveston.jpg', needs: 'Galveston', text: 'First time in salt water, from a boat off the Gulf coast.' },
  { name: 'Offshore', place: 'Flower Garden Banks', x: 81.7, y: 81.2, image: 'test-offshore.jpg', needs: 'Flower Garden Banks', text: 'The goal: filming the deep reefs of Flower Garden Banks, where most of the sanctuary lies in the twilight zone.' },
];

// Turn each entry's Markdown body into HTML we can place on the page
const items = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasPhoto: !!entry.data.image && imageExists(`news/${entry.data.image}`),
  })),
);
---

<BaseLayout title="News" headerOverlay>
  <PageHeader title="News" href="/news" caption="Updates · Photos · Videos" image="news.jpg" imagePosition="47% 50%" />

  <!-- Light band: everything below the photo header -->
  <div class="band band--top theme-light">
    <section class="container news-layout">
      <ol class="news-list" data-reveal-group>
        {items.map(({ entry, Content, hasPhoto }) => (
          <li id={entry.id} class:list={['news-item', { 'news-item--has-photo': hasPhoto }]}>
            <p class:list={['label', 'news-date', { 'news-date--upcoming': entry.data.upcoming }]}>
              {entry.data.date
                ? <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatNewsDate(entry)}</time>
                : formatNewsDate(entry)}
            </p>
            <div class="news-body">
              <h2 class="news-title">{entry.data.title}</h2>
              <div class="news-text"><Content /></div>
            </div>
            {hasPhoto && (
              <div class="news-photo">
                <Photo file={`news/${entry.data.image}`} label={entry.data.title} ratio="4 / 3" />
              </div>
            )}
          </li>
        ))}
      </ol>

    </section>

  </div>

  <!-- Section 01: where we test. An orange band with a map of the test stops (Colossal's locations map) -->
  <TestRoute number={1} title="Where we test" tag="From the pool to the reef" stops={stops} />

  <!-- Closing photo (moray eel, thermal false colour). Copy: Content doc, "Talosaur Live" card. -->
  <PhotoBand image="news.jpg" position="40% 50%" heading="Talosaur Live" tag="Join the live build stream and see our engineers at work">
    <a class="button" href={twitchUrl} target="_blank" rel="noopener noreferrer">Watch on Twitch <span aria-hidden="true">↗</span></a>
  </PhotoBand>
</BaseLayout>

<style>
  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-line);
  }

  /* Each entry is a row: date | title and text | photo (if any) */
  .news-item {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: start;
    gap: var(--space-md) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
    /* When you arrive from a Home page link, leave room for the sticky header */
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .news-item--has-photo {
    grid-template-columns: 12rem 1fr minmax(0, 22rem);
  }

  /* Briefly highlight the entry you jumped to from the Home page */
  .news-item:target .news-title {
    color: var(--color-accent);
  }

  .news-date {
    margin: 0.4rem 0 0;
    color: var(--color-accent);
  }

  /* "Coming soon" in the same plain type as the dates, with a small orange dot before it */
  .news-date--upcoming {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .news-date--upcoming::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .news-title {
    font-size: var(--text-xl);
  }

  .news-text {
    max-width: 38rem;
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .news-text :global(p) {
    margin: 0;
  }

  .news-text :global(p + p) {
    margin-top: var(--space-sm);
  }

  /* Phone: stack date, text and photo */
  @media (max-width: 760px) {
    .news-item,
    .news-item--has-photo {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .news-date {
      margin: 0;
    }

    .news-text {
      font-size: var(--text-base);
    }

    .news-photo {
      margin-top: var(--space-sm);
    }
  }
</style>
